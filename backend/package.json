{
  "name": "billsy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Billsy API: GST billing and invoicing for small Indian businesses",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "db:create": "node scripts/db-create.js",
    "db:drop": "node scripts/db-drop.js",
    "migrate": "knex migrate:latest",
    "rollback": "knex migrate:rollback --all",
    "seed:dev": "node scripts/seed-dev.js",
    "seed:demo": "node scripts/seed-demo.js",
    "ethereal:new": "node scripts/new-ethereal.js",
    "seed:test": "node scripts/seed-test.js",
    "env:make": "node scripts/make-env.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "decimal.js": "10.6.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.3.0",
    "luxon": "3.7.2",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "nodemailer": "10.6.0",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
